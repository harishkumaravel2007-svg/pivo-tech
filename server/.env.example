# PIVO TECH — Server Configuration Example
PORT=5000
NODE_ENV=production

# Security & Sessions
JWT_SECRET=change-this-to-a-secure-random-32-character-secret-in-production
SESSION_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins, or * for all)
# Example: https://pivotech.pages.dev,https://pivotech.in
CORS_ORIGIN=*

# Persistent Storage Paths (Required for persistent volumes on Render / Railway / Docker)
# Leave empty to use default local directories: server/data and server/uploads
DATA_DIR=
UPLOADS_DIR=

# Official Business Communications
BUSINESS_EMAIL=harishkumaravel2007@gmail.com
BUSINESS_PHONE=+919944245043
