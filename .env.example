# PIVO TECH — Monorepo Configuration Template
PORT=5000
NODE_ENV=production

# Security & Sessions
JWT_SECRET=change-this-to-a-secure-random-32-character-secret-in-production
SESSION_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins, or * for all)
CORS_ORIGIN=*

# Persistent Storage Paths (Required for persistent volumes on Render / Railway / Docker)
DATA_DIR=
UPLOADS_DIR=

