{
  "name": "pivo-tech-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm run build --workspace=client",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}

